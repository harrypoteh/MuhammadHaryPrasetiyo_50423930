<?xml version="1.0" encoding="UTF-8"?>
<!--
    Desain laporan MSK Production (Praktikum 6 - JasperReports).

    Laporan ini terhubung langsung ke database aplikasi: query di bawah
    dijalankan memakai koneksi dari kelas Database, sehingga isi laporan
    selalu mengikuti data tabel users yang sedang aktif.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="mskreport" language="java" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              uuid="43702751-4949-4893-b1f7-23598f4c55af">

	<!-- ============================================================
	     Parameter yang dikirim dari program Java
	     ============================================================ -->
	<parameter name="dicetak_oleh" class="java.lang.String">
		<defaultValueExpression><![CDATA["Administrator"]]></defaultValueExpression>
	</parameter>
	<parameter name="tanggal_cetak" class="java.util.Date">
		<defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="nama_database" class="java.lang.String">
		<defaultValueExpression><![CDATA["msk_production_login"]]></defaultValueExpression>
	</parameter>

	<!-- ============================================================
	     Query: sumber data laporan (dijalankan lewat koneksi JDBC)
	     ============================================================ -->
	<queryString language="SQL">
		<![CDATA[SELECT id, username, nama, role FROM users ORDER BY id]]>
	</queryString>

	<field name="id" class="java.lang.Integer"/>
	<field name="username" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="role" class="java.lang.String"/>

	<!-- Variabel agregat: menghitung jumlah baris data akun -->
	<variable name="jumlah_akun" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{id}]]></variableExpression>
		<initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
	</variable>

	<background>
		<band splitType="Stretch"/>
	</background>

	<!-- ============================================================
	     JUDUL LAPORAN
	     ============================================================ -->
	<title>
		<band height="104" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="0" width="555" height="30" uuid="a1000000-0000-0000-0000-000000000001"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="20" isBold="true"/>
				</textElement>
				<text><![CDATA[MSK PRODUCTION]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="30" width="555" height="18" uuid="a1000000-0000-0000-0000-000000000002"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="10" isItalic="true"/>
				</textElement>
				<text><![CDATA[Sistem Produksi Roti]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="56" width="555" height="22" uuid="a1000000-0000-0000-0000-000000000003"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" size="13" isBold="true"/>
				</textElement>
				<text><![CDATA[LAPORAN DAFTAR AKUN ADMINISTRATOR]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="86" width="555" height="1" uuid="a1000000-0000-0000-0000-000000000004"/>
				<graphicElement>
					<pen lineWidth="1.0"/>
				</graphicElement>
			</line>
		</band>
	</title>

	<!-- ============================================================
	     HEADER HALAMAN: info pencetakan
	     ============================================================ -->
	<pageHeader>
		<band height="26" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="2" width="60" height="16" uuid="a1000000-0000-0000-0000-000000000005"/>
